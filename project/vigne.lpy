%pastefile lighting.lpy

def neg_binom(mu, size):
  """ Simulate a discrete negative binomial
      distribution with parameters compatible 
      with R function """
  proba = size/(size + mu)
  return int(negative_binomial(size, proba, 1))


def profile(u, prof_intercept_0, prof_intercept_1, prof_u_max):
  """ Simulate a bilinear function.
  
  @params: u :
    The value at which the function should be evaluate
  @params: prof_intercept_0 :
    The intercept of the increasing part of the function
  @params: prof_intercept_1 :
    The intercept of the decreasing part of the function
  @params: prof_u_max :
    The u value at which the function is maximal
  """
  
  assert 0 <= u <= 1
  if u < prof_u_max:
    return u*(1 - prof_intercept_0)/prof_u_max + prof_intercept_0
  else:
    return (u-prof_u_max) * (prof_intercept_1-1)/(1-prof_u_max) + 1
    

def read_parameters(genotype = 'Carignan', filename = 'parameters_genotypes.csv', sep=';'):
  """ A function to read parameters of the model. The CSV file is expected to contains a dataframe from which the colums indicates the name of variables  and the row the values for each genotype. A column genotype is expected to indicated the genotype name for each row. The different variable names and values of the parameters is directly integrated in the global namespace, making them usable and simple variable 
  
  @params: genotype :
    The name of the genotype to consider in the file
  @params: filename :
    The file name which contains the parameters of the model in CSV format
  @params: sep :
     The separator used in the CSV file
  """
  
  import pandas as pd
  df = pd.read_csv(filename, sep=sep)
  df.set_index('genotype', drop=True,inplace=True)
  for pname, pvalue in df[:genotype].iloc[0].items():
    print(pname,'=',pvalue)
    globals()[pname] = pvalue


def profile_internode(u):
  """ Return the lenght of the internode according to its normalized position on the axis """
  return profile(u, prof_intercept_in_0, prof_intercept_in_1, prof_u_max_in)

def profile_leaf(u):
  """ Return the size of the leaf according to its normalized position on the axis """
  return profile(u, prof_intercept_sf_0, prof_intercept_sf_1, prof_u_max_sf)

